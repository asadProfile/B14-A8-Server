{
  "name": "studiosspace-server",
  "version": "1.0.0",
  "private": true,
  "description": "StudioSpace API — peer-to-peer creative studio marketplace",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "seed": "node src/utils/seed-cli.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "config": {
    "mongodbMemoryServer": {
      "downloadDir": "node_modules/.cache/mongodb-memory-server"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "google-auth-library": "^10.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^8.24.8",
    "morgan": "^1.10.1",
    "multer": "^2.5.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
