# ------------------------------------------------------------------
# StudioSpace API — environment template
# Copy to .env and fill in the values for your environment.
# ------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development

# Public URL of this API (used to build absolute upload URLs).
# Leave empty in development to derive it from the request.
PUBLIC_API_URL=

# Client origin allowed by CORS. Comma-separated list is supported.
CLIENT_URL=http://localhost:3000

# MongoDB
# Leave blank in development to use an in-memory MongoDB automatically.
# In production a real connection string is required (MongoDB Atlas).
MONGODB_URI=

# Auth
JWT_SECRET=replace-me-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Seed demo data automatically when the database is empty.
# Set to "false" to skip. Credentials created by the seed:
#   examiner@studiosspace.com / Studio123
#   host@studiosspace.com     / Studio123
AUTO_SEED=true

# Image uploads (optional). Uploads use ImgBB when a key is set, Vercel Blob
# when BLOB_READ_WRITE_TOKEN is present (added automatically when a Blob store
# is connected to the Vercel project), otherwise server/uploads.
IMGBB_API_KEY=
BLOB_READ_WRITE_TOKEN=

# Google OAuth (optional). Register the callback on every origin the app is
# opened from — the server builds it from the origin the browser used:
#   http://localhost:3000/api/auth/google/callback
#   http://localhost:5000/api/auth/google/callback   (direct API access)
#   https://<your-client-domain>/api/auth/google/callback
# CLIENT_URL above must list those origins, comma-separated; the Next.js
# proxy forwards the browser origin in x-forwarded-host.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
